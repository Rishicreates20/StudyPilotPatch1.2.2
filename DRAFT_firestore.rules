rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == 'rishikeshsarangi122004@gmail.com' ||
         (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true));
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // User goals subcollection
      match /goals/{goalId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // User flashcards subcollection
      match /flashcards/{cardId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // User quizzes subcollection
      match /quizzes/{quizId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // Reading timer and progress metrics
      match /progress/{progressId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }
  }
}
